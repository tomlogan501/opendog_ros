<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>opendog_hardware_layer_can</name>
  <version>0.0.1</version>
  <description>Configuration, launch and URDF for OpenDog's CAN hardware layer</description>
  <maintainer email="jobs@reebot.tech">Reebot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>controller_manager</depend>
  <depend>hardware_interface</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  
  <!-- Launch dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  
  <!-- Robot description dependencies -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  
  <!-- Dependencies on other packages -->
  <exec_depend>opendog_description</exec_depend>

  <!-- Folder installation -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>