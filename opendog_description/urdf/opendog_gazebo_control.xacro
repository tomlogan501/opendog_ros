<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macro Gazebo pour connecter ros2_control -->
  <xacro:macro name="opendog_gazebo_control" params="name">
    <gazebo>
      <plugin name="${name}_gazebo_ros2_control" filename="libgazebo_ros2_control.so"/>
    </gazebo>
  </xacro:macro>

</robot>
